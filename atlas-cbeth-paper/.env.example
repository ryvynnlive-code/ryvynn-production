# ── Safety guards ──────────────────────────────────────────────────────────────
# Both must be exactly these values. System exits hard if either is wrong.
DRY_RUN=true
ALLOW_LIVE=false

# ── Bot identity ───────────────────────────────────────────────────────────────
BOT_ID=archerbot-01
STRATEGY_ID=cbeth-fv-v1
# RUN_ID is generated automatically at startup (uuid4) — do not set here

# ── Base RPC ───────────────────────────────────────────────────────────────────
# Use a paid provider (Alchemy, QuickNode, etc.) — public RPCs serve stale data
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# ── Contract addresses — verify each before use ────────────────────────────────
# cbETH token on Base — verify address before running
CBETH_ADDRESS=
# Canonical WETH on Base (OP-stack standard)
WETH_ADDRESS=0x4200000000000000000000000000000000000006
# Uniswap V3 QuoterV2 on Base — verify address before running
QUOTER_ADDRESS=
# Uniswap V3 cbETH/WETH pool on Base — verify address before running
POOL_ADDRESS=

# ── Pool configuration ─────────────────────────────────────────────────────────
# Fee tier in raw units: 100=0.01%, 500=0.05%, 3000=0.3%, 10000=1%
# Verify against the actual pool's fee() return value at startup
POOL_FEE_TIER=500

# ── Edge thresholds ────────────────────────────────────────────────────────────
# Minimum net edge (bps) to log an opportunity and open a paper trade
MIN_EDGE_BPS=10
# Paper trade notional in ETH — must be realistic for the pool's actual liquidity
TRADE_SIZE_ETH=1.0
# Assumed execution slippage on top of the quoted execution price
SLIPPAGE_BPS=30
# Additional conservatism buffer
SAFETY_BUFFER_BPS=20

# ── Liquidity / impact guards ─────────────────────────────────────────────────
# Reject quotes from pools with liquidity below this threshold (raw uint128)
MIN_POOL_LIQUIDITY=1000000000000000000
# Reject if price impact exceeds this (bps)
MAX_PRICE_IMPACT_BPS=50

# ── RPC freshness ──────────────────────────────────────────────────────────────
# Reject if latest block timestamp is older than this (seconds)
BLOCK_FRESHNESS_SEC=15

# ── Paper trade hold limit ─────────────────────────────────────────────────────
# Auto-close paper trades that have been open this many blocks
MAX_HOLD_BLOCKS=10

# ── Paths ──────────────────────────────────────────────────────────────────────
LOG_DIR=./logs
DEDUP_DB_PATH=./logs/dedup.sqlite
KILL_SWITCH_PATH=./KILL_SWITCH

# ── Polling ───────────────────────────────────────────────────────────────────
# Seconds between main loop iterations (Base ~2s block time)
POLL_INTERVAL_SEC=2
